{
  "entities": {
    "MarketCandle": {
      "title": "Market Candle",
      "description": "Historical price data for a market pair",
      "type": "object",
      "properties": {
        "pair": { "type": "string" },
        "type": { "type": "string" },
        "timeframe": { "type": "string" },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" },
        "volume": { "type": "number" },
        "openTime": { "type": "number" },
        "closeTime": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["pair", "type", "timeframe", "open", "high", "low", "close", "volume", "openTime", "closeTime"]
    },
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "kyc_status": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "User support request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "subject", "status"]
    },
    "SupportMessage": {
      "title": "Support Message",
      "description": "Message within a support ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketId": { "type": "string" },
        "userId": { "type": "string" },
        "senderType": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "ticketId", "userId", "senderType", "text", "createdAt"]
    },
    "KycRequest": {
      "title": "KYC Request",
      "description": "Identity verification request",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "fullName": { "type": "string" },
        "idType": { "type": "string" },
        "idNumber": { "type": "string" },
        "idFrontUrl": { "type": "string" },
        "idBackUrl": { "type": "string" },
        "selfieUrl": { "type": "string" },
        "submittedAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "status", "fullName", "idType", "idNumber", "idFrontUrl", "submittedAt"]
    }
  },
  "firestore": {
    "/market_candles/{candleId}": {
      "schema": "MarketCandle",
      "description": "Market price history"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets"
    },
    "/tickets/{ticketId}/messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Messages for a support ticket"
    },
    "/kyc_requests/{requestId}": {
      "schema": "KycRequest",
      "description": "KYC verification requests"
    }
  }
}
