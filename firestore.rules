rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // SECURITY HELPERS
    // -------------------------------------------------------------------------
    
    // Checks if a client is authenticated via Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the authenticated user is the owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks if the authenticated user is a verified administrator
    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        request.auth.token.email in [
          "hamproo123@gmail.com",
          "hamproosapport@gmail.com",
          "hamproosupport@gmail.com",
          "bivaaxtrader@gmail.com"
        ] ||
        request.auth.uid == "HFvr43UhRiTSjb6m5sQJHmHGNvm1"
      );
    }

    // Prevents document ID poisoning by enforcing character and length limits
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // DEFAULT SAFETY NET (Zero-Trust)
    // -------------------------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // COLLECTION RULES
    // -------------------------------------------------------------------------

    // 1. User Profiles & Balances
    // Only the profile owner or an administrator can access or modify user records.
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 2. Support Tickets & Conversations
    // Users can read and write only their own support tickets. Administrators have full access.
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
      
      // Messages within support tickets
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // 3. KYC Verification Requests
    // Protects Personally Identifiable Information (PII) by restricting read/write to the applicant or admin.
    match /kyc_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }
    match /kycRequests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }

    // 4. Platform Config & App Settings
    // Read-only for the public; only admins can adjust trading/system settings.
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Market Candle Data
    // Available publicly to build trading charts; writable only by the admin system / market engine.
    match /market_candles/{candleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Educational Content, News & Promotions
    // Publicly readable; administrators handle content management.
    match /news/{newsId} { allow read: if true; allow write: if isAdmin(); }
    match /education/{eduId} { allow read: if true; allow write: if isAdmin(); }
    match /promotions/{promoId} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{bannerId} { allow read: if true; allow write: if isAdmin(); }
    match /pages/{pageId} { allow read: if true; allow write: if isAdmin(); }

    // 7. Trading Tournaments & Signals
    // Publicly read; managed by system admins.
    match /tournaments/{tournId} { allow read: if true; allow write: if isAdmin(); }
    match /signals/{signalId} { allow read: if true; allow write: if isAdmin(); }
    match /masterTraders/{traderId} { allow read: if true; allow write: if isAdmin(); }

    // 8. Payment & Deposit Methods
    // Available for users to view during payment processing; manageable only by admin panel.
    match /depositMethods/{methodId} { allow read: if true; allow write: if isAdmin(); }
    match /promoMaterials/{promoId} { allow read: if true; allow write: if isAdmin(); }

    // 9. Financial Actions (Deposits, Withdrawals, & Affiliates)
    // Directly secure transactional collections from unauthorized direct write operations.
    match /deposits/{depId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }
    match /withdrawals/{withId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }
    match /affiliate_payouts/{payoutId} {
      allow read, write: if isAdmin();
    }

    // 10. System & Auditing Logs
    // Restricted entirely to administrators.
    match /systemLogs/{logId} {
      allow read, write: if isAdmin();
    }
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Trades Sync
    match /trades/{tradeId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }
  }
}
